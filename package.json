{
  "name": "be",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "bun run build && bun dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:seed": "bun ./src/db/seed.ts",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:generateMigration": "bunx drizzle-kit generate",
    "test:integration": "bun scripts/run-integration.ts",
    "verify:runtime": "bun scripts/verify-runtime.ts",
    "auth:setup": "bun scripts/setup-auth-secret.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1"
  }
}
