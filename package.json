{
  "name": "be",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run build && bun dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:seed": "bun ./src/db/seed.ts",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:generateMigration": "bunx drizzle-kit generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "@nestjs/testing": "^11.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
